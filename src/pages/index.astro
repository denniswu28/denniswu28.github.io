  research: 'M19.8 18.4 14 10.67V6.5l1.35-1.69c.26-.33.03-.81-.39-.81H9.04c-.42 0-.65.48-.39.81L10 6.5v4.17L4.2 18.4c-.49.66-.02 1.6.8 1.6h14c.82 0 1.29-.94.8-1.6Z',
  quant: 'M3.5 18.49l6-6.01 4 4L22 6.92l-1.41-1.41-7.09 7.97-4-4L2 16.99z',
  doc: 'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6Zm2 16H8v-2h8v2Zm0-4H8v-2h8v2Zm-3-5V3.5L18.5 9H13Z',
  github: 'M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.5 11.5 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12Z',
  linkedin: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286ZM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124ZM7.119 20.452H3.555V9h3.564v11.452ZM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003Z',
  mail: 'M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z',
  scholar: 'M5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82ZM12 3 1 9l11 6 9-4.91V17h2V9L12 3Z',
  orcid: 'M20 7h-5V4c0-1.1-.9-2-2-2h-2c-1.1 0-2 .9-2 2v3H4c-1.1 0-2 .9-2 2v11c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V9c0-1.1-.9-2-2-2ZM9 12c.83 0 1.5.67 1.5 1.5S9.83 15 9 15s-1.5-.67-1.5-1.5S8.17 12 9 12Zm3 6H6v-.75c0-1 2-1.5 3-1.5s3 .5 3 1.5V18Zm1-9h-2V4h2v5Zm5 7.5h-4V15h4v1.5Zm0-3h-4V12h4v1.5Z',
  ads: 'M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6Zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2Zm-1 9H9V9h10v2Zm-4 4H9v-2h6v2Zm4-8H9V5h10v2Z'
};

const links = [
  { label: 'Research', href: '/academic/', icon: icon.research },
  { label: 'Quantitative research', href: '/quant/', icon: icon.quant },
  { label: 'CV (PDF)', href: site.cv, icon: icon.doc, external: true },
  { label: 'Resume (PDF)', href: site.resume, icon: icon.doc, external: true },
  { label: 'Google Scholar', href: site.scholar, icon: icon.scholar, external: true },
  { label: 'ORCID', href: site.orcid, icon: icon.orcid, external: true },
  { label: 'NASA ADS', href: site.ads, icon: icon.ads, external: true },
  { label: 'GitHub', href: site.github, icon: icon.github, external: true },
  { label: 'LinkedIn', href: site.linkedin, icon: icon.linkedin, external: true }
];
---

<BaseLayout title={site.name} description={site.description}>
  <div class="shell home">
    <aside class="home-side" aria-label="Profile">
      <div class="side-id">
        <img class="home-photo" src="/images/portrait.jpg" alt="Portrait of Tianrui (Dennis) Wu" width="170" height="170" />
        <div>
          <h1>{site.name}</h1>
          <p class="side-roles">
            Physics, University of Arizona<br />
            Arizona Cosmology Lab<br />
            Quantitative researcher, Qrigin Capital
          </p>
          <p class="side-loc"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={icon.pin} /></svg>Steward Observatory, Tucson, AZ</p>
        </div>
      </div>

      <div class="side-group">
      <h2 class="side-heading">Links</h2>
      <ul class="side-links">
        {links.map((link) => (
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={link.icon} /></svg>
            <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener' : undefined}>{link.label}</a>
          </li>
        ))}
      </ul>
      </div>

      <div class="side-group">
      <h2 class="side-heading">Contact</h2>
      <ul class="side-links">
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d={icon.mail} /></svg><a href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
      </div>
    </aside>

    <div class="home-main">
      <section aria-labelledby="about-heading">
        <h2 class="rule-heading" id="about-heading">About</h2>
        <p>I am a physics student at the University of Arizona, with a minor in mathematics. I work in the Arizona Cosmology Lab with Prof. Tim Eifler, and on data tools for Event Horizon Telescope simulations with Prof. Chi-kwan Chan. My current project tests when baryon acoustic oscillation reconstruction still improves distance measurements for galaxy samples with SPHEREx-like redshift errors.</p>
        <p>I also work as a quantitative researcher and systematic trader at Qrigin Capital, where I build forecasting models, market simulators and monitoring for crypto markets.</p>
        <p>Before Arizona, I studied physics and mathematics at Duke University and did research with Prof. Michael Troxel and Prof. Daniel Scolnic. In 2024 I spent a summer on the SPHEREx team at Caltech with Dr. Olivier Doré.</p>

        <div class="paths">
          {homePaths.map((path) => (
            <section class="path" aria-labelledby={`path-${path.id}`}>
              <h3 id={`path-${path.id}`}>{path.title}</h3>
              <p>{path.text}</p>
              <div class="button-row">
                <a class="button" href={path.href}>{path.linkLabel}</a>
                <a class="button button-secondary" href={path.document.href} target="_blank" rel="noopener">{path.document.label}</a>
              </div>
            </section>
          ))}
        </div>
      </section>

      <section aria-labelledby="news-heading">
        <h2 class="rule-heading" id="news-heading">News</h2>
        <ul class="dated-list">
          {news.map((item) => (
            <li><span class="date-block">{item.date}</span><span>{item.text}</span></li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="education-heading">
        <h2 class="rule-heading" id="education-heading">Education</h2>
        <ul class="edu-list">
          {education.map((item) => (
            <li><strong>{item.school}</strong><span class="edu-degree">{item.degree}</span><span>{item.dates}</span></li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="interests-heading">
        <h2 class="rule-heading" id="interests-heading">Research interests</h2>
        <ul class="plain-list">{interests.map((item) => <li>{item}</li>)}</ul>
      </section>
    </div>
  </div>
</BaseLayout>
