---
import BaseLayout from '../layouts/BaseLayout.astro';
import { education, homePaths, interests, news, site } from '../data/site';
---

<BaseLayout title={site.name} description={site.description}>
  <div class="shell">
    <section class="profile" aria-labelledby="profile-name">
      <aside class="profile-card">
        <img src="/images/portrait.jpg" alt="Portrait of Tianrui (Dennis) Wu" width="200" height="200" />
        <h1 id="profile-name">{site.name}</h1>
        <p>Physics, University of Arizona</p>
        <p class="affiliation">Arizona Cosmology Lab</p>
        <div class="icon-links">
          <a href={`mailto:${site.email}`} aria-label="Email" title="Email">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z"/></svg>
          </a>
          <a href={site.github} aria-label="GitHub" title="GitHub" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.5 11.5 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12Z"/></svg>
          </a>
          <a href={site.linkedin} aria-label="LinkedIn" title="LinkedIn" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286ZM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124ZM7.119 20.452H3.555V9h3.564v11.452ZM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003Z"/></svg>
          </a>
          <a href="/documents/" aria-label="CV and resume" title="CV and resume"><span class="cv-text">CV</span></a>
        </div>
      </aside>

      <div class="profile-bio">
        <h2>About</h2>
        <p>I am a physics student at the University of Arizona, with a minor in mathematics. I work in the Arizona Cosmology Lab with Prof. Tim Eifler, and on data tools for Event Horizon Telescope simulations with Prof. Chi-kwan Chan. My current project tests when baryon acoustic oscillation reconstruction still improves distance measurements for galaxy samples with SPHEREx-like redshift errors.</p>
        <p>I also work as a quantitative researcher and systematic trader at Qrigin Capital, where I build forecasting models, market simulators and monitoring for crypto markets.</p>
        <p>Before Arizona, I studied physics and mathematics at Duke University and did research with Prof. Michael Troxel and Prof. Daniel Scolnic. In 2024 I spent a summer on the SPHEREx team at Caltech with Dr. Olivier Doré.</p>

        <div class="paths">
          {homePaths.map((path) => (
            <section class="path" aria-labelledby={`path-${path.id}`}>
              <h3 id={`path-${path.id}`}>{path.title}</h3>
              <p>{path.text}</p>
              <div class="button-row">
                <a class="button" href={path.href}>{path.linkLabel}</a>
                <a class="button button-secondary" href={path.document.href} target="_blank" rel="noopener">{path.document.label}</a>
              </div>
            </section>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="two-col">
        <div>
          <h2 class="rule-heading">Interests</h2>
          <ul class="plain-list">{interests.map((item) => <li>{item}</li>)}</ul>
        </div>
        <div>
          <h2 class="rule-heading">Education</h2>
          <ul class="edu-list">
            {education.map((item) => (
              <li><strong>{item.degree}</strong><span>{item.school}, {item.dates}</span></li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="news-heading">
      <h2 class="rule-heading" id="news-heading">News</h2>
      <ul class="dated-list">
        {news.map((item) => (
          <li><span class="date-block">{item.date}</span><span>{item.text}</span></li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
