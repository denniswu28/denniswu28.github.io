---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { experiences, independentProjects, quantCode, quantMethods, site } from '../../data/site';
import { filterPublished } from '../../lib/content';

const experiments = filterPublished(await getCollection('experiments'));
const quantArticles = filterPublished(await getCollection('articles')).filter((article) => article.data.category === 'quant-research');
const theses = filterPublished(await getCollection('theses'));
---

<BaseLayout title="Quantitative Research" description="Quantitative research and trading by Tianrui (Dennis) Wu: forecasting, market making, execution research and market-data systems.">
  <div class="shell">
    <header class="page-intro">
      <h1>Quantitative research</h1>
      <p class="lede">I am a quantitative researcher and systematic trader at Qrigin Capital, a startup proprietary trading firm. I work on forecasting, execution, market making and live risk for books traded on OKX, Binance and Coinbase.</p>
      <div class="button-row">
        <a class="button" href={site.resume} target="_blank" rel="noopener">Resume (PDF)</a>
        <a class="button button-secondary" href={`mailto:${site.email}`}>Email</a>
      </div>
      <nav class="toc" aria-label="On this page">
        <a href="#experience">Experience</a>
        <a href="#independent-projects">Projects</a>
        <a href="#case-studies">Case studies and writing</a>
        <a href="#capabilities">Methods</a>
      </nav>
    </header>

    <section class="section" id="experience" aria-labelledby="experience-heading">
      <h2 class="rule-heading" id="experience-heading">Experience</h2>
      {experiences.map((experience) => (
        <article class="entry" id={experience.id}>
          <h3>{experience.role}</h3>
          <p class="meta">
            <span>{experience.dates}</span>
            <span>{experience.organization} · {experience.location}</span>
          </p>
          <ul>{experience.accomplishments.map((item) => { const i = item.indexOf(': '); return i > 0 && i < 40 ? <li><strong>{item.slice(0, i)}:</strong> {item.slice(i + 2)}</li> : <li>{item}</li>; })}</ul>
          <div class="tech-row">{experience.technologies.map((technology) => <span>{technology}</span>)}</div>
        </article>
      ))}
    </section>

    <section class="section" id="independent-projects" aria-labelledby="projects-heading">
      <h2 class="rule-heading" id="projects-heading">Projects</h2>
      <ul class="dated-list">
        {independentProjects.map((project) => (
          <li id={project.id}><span class="date-block">{project.dates}</span><div><strong>{project.title}</strong><p>{project.text}</p></div></li>
        ))}
      </ul>
      <h3 style="margin-top: 22px">Code</h3>
      <ul class="software-list">
        {quantCode.map((repo) => (
          <li><code>{repo.name}</code><p>{repo.text} <a href={repo.href} target="_blank" rel="noopener">{repo.href.replace('https://', '')}</a></p></li>
        ))}
      </ul>
    </section>

    <section class="section" id="case-studies" aria-labelledby="case-heading">
      <h2 class="rule-heading" id="case-heading">Case studies and writing</h2>
      <ul class="software-list">
        {experiments.map((experiment) => (
          <li><a href={`/lab/${experiment.data.slug}/`}><strong>{experiment.data.title}</strong></a><p>{experiment.data.summary}</p></li>
        ))}
        {quantArticles.map((article) => (
          <li><a href={`/blog/${article.data.category}/${article.data.slug}/`}><strong>{article.data.title}</strong></a><p>{article.data.summary}</p></li>
        ))}
        {theses.map((thesis) => (
          <li><a href={`/portfolio/${thesis.data.slug}/`}><strong>{thesis.data.title}</strong></a><p>{thesis.data.summary}</p></li>
        ))}
      </ul>
      <p class="notice" style="margin-top: 14px">Case studies use public, synthetic, delayed or aggregated data. Historical research is not investment advice.</p>
    </section>

    <section class="section" id="capabilities" aria-labelledby="methods-heading">
      <h2 class="rule-heading" id="methods-heading">Methods</h2>
      <p>{quantMethods}</p>
    </section>
  </div>
</BaseLayout>
