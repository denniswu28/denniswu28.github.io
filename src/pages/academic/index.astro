---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { awards, education, inPreparation, outreach, researchProjects, site, software, talks, teaching } from '../../data/site';
import { filterPublished } from '../../lib/content';

const publications = filterPublished(await getCollection('publications')).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);
// Bold the "Wu, T." author token in each citation.
const splitCitation = (citation: string) => {
  const marker = citation.includes('T. Wu') ? 'T. Wu' : 'Wu, T.';
  const index = citation.indexOf(marker);
  return index === -1 ? [citation, '', ''] : [citation.slice(0, index), marker, citation.slice(index + marker.length)];
};
---

<BaseLayout title="Research" description="Cosmology research by Tianrui (Dennis) Wu: BAO reconstruction with photometric redshifts, SPHEREx, Roman and Rubin, publications, talks and software.">
  <div class="shell">
    <header class="page-intro">
      <h1>Research</h1>
      <p class="lede">I work in observational cosmology. Most of my projects ask how a measurement limit, such as photometric-redshift error or a survey window, changes what a galaxy survey can measure. I build the simulations, pipelines and statistics needed to answer that.</p>
      <div class="button-row">
        <a class="button" href={site.cv} target="_blank" rel="noopener">Academic CV (PDF)</a>
        <a class="button button-secondary" href={`mailto:${site.email}`}>Email</a>
      </div>
      <nav class="toc" aria-label="On this page">
        <a href="#projects">Projects</a>
        <a href="#publications">Publications</a>
        <a href="#talks">Talks</a>
        <a href="#software">Software</a>
        <a href="#teaching">Teaching and outreach</a>
        <a href="#recognition">Awards</a>
        <a href="#education">Education</a>
      </nav>
    </header>

    <section class="section" id="projects" aria-labelledby="projects-heading">
      <h2 class="rule-heading" id="projects-heading">Projects</h2>
      {researchProjects.map((project) => (
        <article class:list={['entry', { 'has-figure': Boolean(project.figure) }]} id={project.id}>
          <div>
            <h3>{project.title}</h3>
            <p class="meta">
              <span>{project.dates}</span>
              <span>{project.group}</span>
              <span>Advisor: {project.advisor}</span>
            </p>
            {project.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {project.links.length > 0 && (
              <p class="link-line">Code: {project.links.map((link) => <a href={link.href} target="_blank" rel="noopener">{link.label}</a>)}</p>
            )}
          </div>
          {project.figure && (
            <figure>
              <img src={project.figure.src} alt={project.figure.alt} loading="lazy" />
              <figcaption>{project.figure.caption}</figcaption>
            </figure>
          )}
        </article>
      ))}
    </section>

    <section class="section" id="publications" aria-labelledby="publications-heading">
      <h2 class="rule-heading" id="publications-heading">Publications</h2>
      <ol class="pub-list" reversed>
        {inPreparation.map((paper) => {
          const [before, me, after] = splitCitation(paper.authors);
          return (
            <li>
              {before}<strong>{me}</strong>{after} <span class="pub-title">“{paper.title}.”</span> <span class="status">{paper.status}.</span>
            </li>
          );
        })}
        {publications.map((publication) => {
          const [before, me, after] = splitCitation(publication.data.citation);
          return (
            <li>
              {before}<strong>{me}</strong>{after}
              <span class="pub-links">
                {publication.data.journalUrl && <a href={publication.data.journalUrl} target="_blank" rel="noopener">Journal</a>}
                {publication.data.arxivUrl && <a href={publication.data.arxivUrl} target="_blank" rel="noopener">arXiv</a>}
                <a href={`/academic/publications/${publication.data.slug}/`}>Summary</a>
              </span>
            </li>
          );
        })}
      </ol>
    </section>

    <section class="section" id="talks" aria-labelledby="talks-heading">
      <h2 class="rule-heading" id="talks-heading">Talks</h2>
      <ul class="dated-list">
        {talks.map((talk) => (
          <li><span class="date-block">{talk.date}</span><div><strong>{talk.title}</strong><p>{talk.venue}</p></div></li>
        ))}
      </ul>
    </section>

    <section class="section" id="software" aria-labelledby="software-heading">
      <h2 class="rule-heading" id="software-heading">Software</h2>
      <ul class="software-list">
        {software.map((item) => (
          <li>
            <code>{item.name}</code> <span class="role">{item.role}</span>
            <p>{item.text} {item.href && <a href={item.href} target="_blank" rel="noopener">{item.href.replace('https://', '')}</a>}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="section" id="teaching" aria-labelledby="teaching-heading">
      <h2 class="rule-heading" id="teaching-heading">Teaching and outreach</h2>
      <ul class="dated-list">
        {[...teaching, ...outreach].map((item) => (
          <li><span class="date-block">{item.dates}</span><div><strong>{item.role}</strong><p>{item.text}</p></div></li>
        ))}
      </ul>
    </section>

    <section class="section" id="recognition" aria-labelledby="awards-heading">
      <h2 class="rule-heading" id="awards-heading">Awards</h2>
      <ul class="dated-list">
        {awards.map((award) => (
          <li><span class="date-block">{award.year}</span><span>{award.text}</span></li>
        ))}
      </ul>
    </section>

    <section class="section" id="education" aria-labelledby="education-heading">
      <h2 class="rule-heading" id="education-heading">Education</h2>
      <ul class="dated-list">
        {education.map((item) => (
          <li><span class="date-block">{item.dates}</span><div><strong>{item.degree}</strong><p>{item.school}. {item.note}.</p></div></li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
